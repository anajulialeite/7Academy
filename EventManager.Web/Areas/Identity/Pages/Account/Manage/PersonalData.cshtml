@page
@{
    ViewData["Title"] = "Dados Pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="text-warning">@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-8">
        <p class="text-light">Sua conta contém dados pessoais que você nos forneceu. Esta página permite baixar ou excluir esses dados.</p>
        <p class="text-light">
            <strong>A exclusão desses dados removerá permanentemente sua conta e não poderá ser recuperada.</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post" class="form-group">
            <button class="btn btn-warning mb-3 fw-bold" type="submit"><i class="bi bi-download me-1"></i>Baixar meus dados</button>
        </form>
        <a asp-page="DeletePersonalData" class="btn btn-danger fw-bold"><i class="bi bi-trash-fill me-1"></i>Excluir minha conta</a>
    </div>
</div>