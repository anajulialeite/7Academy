@page
@model RegisterModel

@{
    ViewData["Title"] = "Criar Conta";
}

<div class="row justify-content-center align-items-center mt-5">
    
    <div class="col-md-5 d-none d-md-block text-center">
        <div class="p-4 bg-dark-purple rounded-4 border border-warning shadow-lg">
            <h3 class="text-warning mb-3">Junte-se à 7Academy</h3>
            <p class="text-light mb-4">Crie sua conta agora mesmo para se inscrever nos melhores eventos acadêmicos, garantir sua vaga e receber seus certificados digitais válidos.</p>
            <i class="bi bi-mortarboard" style="font-size: 8rem; color: #D4AF37;"></i>
        </div>
    </div>

    <div class="col-md-5 offset-md-1 mb-4">
        <div class="card shadow-lg border-warning rounded-4 overflow-hidden">
            <div class="card-header bg-dark-purple text-warning text-center py-4 border-bottom border-warning">
                <h2 class="mb-0 fw-bold"><i class="bi bi-person-plus me-2"></i>Registrar</h2>
            </div>
            <div class="card-body p-4 p-md-5">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    
                    <div class="form-floating mb-4 text-dark">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" style="background-color: #fff; color: #333;" />
                        <label asp-for="Input.Email" class="form-label text-muted">E-mail</label>
                        <span asp-validation-for="Input.Email" class="text-warning fw-bold"></span>
                    </div>
                    
                    <div class="form-floating mb-4 text-dark">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" style="background-color: #fff; color: #333;" />
                        <label asp-for="Input.Password" class="form-label text-muted">Senha</label>
                        <span asp-validation-for="Input.Password" class="text-warning fw-bold"></span>
                    </div>

                    <div class="form-floating mb-4 text-dark">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" style="background-color: #fff; color: #333;" />
                        <label asp-for="Input.ConfirmPassword" class="form-label text-muted">Confirmar Senha</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-warning fw-bold"></span>
                    </div>
                    
                    <div>
                        <button id="registerSubmit" type="submit" class="w-100 btn btn-primary btn-lg rounded-pill shadow-sm mb-3">Criar Conta</button>
                    </div>
                    
                    <div class="text-center mt-4">
                        <p class="mb-2">
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-warning text-decoration-none">Já tem uma conta? Faça login</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
