@model IEnumerable<EventManager.Web.Models.Event>

@{
    ViewData["Title"] = "Eventos Disponíveis";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-warning"><i class="bi bi-calendar-event me-2"></i>Eventos Acadêmicos</h1>
    @if (User.IsInRole("Organizador"))
    {
        <a asp-action="Create" class="btn btn-warning fw-bold rounded-pill"><i class="bi bi-plus-circle-fill me-2"></i>Criar Novo Evento</a>
    }
</div>

<div class="row">
    @foreach (var item in Model) {
        <div class="col-md-4 mb-4">
            <div class="card bg-dark-purple border-warning h-100 shadow-sm">
                <div class="card-header border-warning pt-3">
                    <h5 class="card-title text-warning fw-bold mb-0">@item.Title</h5>
                </div>
                <div class="card-body text-light">
                    <p class="card-text text-muted mb-3"><i class="bi bi-clock me-1"></i> @item.DateTime.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="card-text">@item.Description</p>
                </div>
                <div class="card-footer border-0 bg-transparent pt-0 pb-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="badge bg-warning text-dark"><i class="bi bi-people-fill me-1"></i>Vagas: @item.TotalSlots</span>
                        <span class="badge border border-warning text-warning"><i class="bi bi-hourglass-split me-1"></i>Carga: @item.WorkloadHours h</span>
                    </div>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-warning rounded-pill fw-bold w-100">Ver Detalhes</a>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="p-5 bg-dark-purple border border-warning rounded shadow-sm">
                <i class="bi bi-calendar-x text-warning" style="font-size: 3rem;"></i>
                <h4 class="text-light mt-3">Nenhum evento disponível no momento.</h4>
            </div>
        </div>
    }
</div>