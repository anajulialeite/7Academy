@model IEnumerable<EventManager.Web.Models.EventRegistration>

@{
    ViewData["Title"] = "Minhas Inscrições";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-warning"><i class="bi bi-ticket-perforated-fill me-2"></i>Minhas Inscrições</h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-6 mb-4">
            <div class="card bg-dark-purple border-warning shadow-sm h-100">
                <div class="card-header border-warning pb-2 pt-3">
                    <h5 class="mb-0 text-warning fw-bold">@item.Event?.Title</h5>
                </div>
                <div class="card-body text-light">
                    <p class="mb-2"><i class="bi bi-calendar-event me-2 text-warning"></i><strong>Data do Evento:</strong> @item.Event?.DateTime.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-2"><i class="bi bi-person-badge me-2 text-warning"></i><strong>Organizador:</strong> @(string.IsNullOrEmpty(item.Event?.Organizer?.FullName) ? item.Event?.Organizer?.UserName : item.Event?.Organizer?.FullName)</p>
                    <p class="mb-2"><i class="bi bi-clock-history me-2 text-warning"></i><strong>Carga Horária:</strong> @item.Event?.WorkloadHours horas</p>
                    
                    <div class="mt-3 p-3 bg-dark rounded border border-warning d-flex justify-content-between align-items-center">
                        <div>
                            <span class="d-block text-muted small mb-1">Status de Presença</span>
                            @if (item.IsPresenceConfirmed)
                            {
                                <span class="badge bg-success fs-6"><i class="bi bi-check-circle-fill me-1"></i>Confirmada</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6"><i class="bi bi-hourglass-split me-1"></i>Pendente</span>
                            }
                        </div>
                        
                        @if (item.IsPresenceConfirmed)
                        {
                            <a asp-action="DownloadCertificate" asp-route-id="@item.Id" class="btn btn-warning fw-bold"><i class="bi bi-file-earmark-pdf-fill me-1"></i>Baixar Certificado</a>
                            <a asp-controller="Quiz" asp-action="Take" asp-route-id="@item.Id" class="btn btn-outline-warning fw-bold"><i class="bi bi-arrow-repeat me-1"></i>Refazer Prova</a>
                        }
                        else
                        {
                            <a asp-controller="Quiz" asp-action="Take" asp-route-id="@item.Id" class="btn btn-outline-warning fw-bold"><i class="bi bi-pencil-square me-1"></i>Realizar Avalia&ccedil;&atilde;o</a>
                        }
                    </div>
                    
                    <a asp-controller="Quiz" asp-action="Material" asp-route-id="@item.Id" target="_blank" class="btn btn-warning w-100 fw-bold mt-3"><i class="bi bi-book-fill me-2"></i>Material de Estudo (PDF)</a>
                    @{
                        var history = (ViewBag.Attempts as Dictionary<int, List<EventManager.Web.Models.QuizAttempt>>)?.GetValueOrDefault(item.Id);
                    }
                    @if (history != null && history.Any())
                    {
                        <div class="mt-3">
                            <button class="btn btn-sm btn-outline-warning w-100 d-flex justify-content-between align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#hist-@item.Id">
                                <span><i class="bi bi-clock-history me-1"></i>Hist&oacute;rico de notas (@history.Count)</span>
                                <span>Maior nota: <strong>@history.Max(h => h.Score),0</strong></span>
                            </button>
                            <div class="collapse show" id="hist-@item.Id">
                                <table class="table table-dark table-sm mt-2 mb-0 align-middle">
                                    <thead><tr class="text-warning"><th>Data</th><th class="text-center">Nota</th><th class="text-end">Resultado</th></tr></thead>
                                    <tbody>
                                        @foreach (var h in history)
                                        {
                                            <tr>
                                                <td>@h.AttemptDate.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="text-center fw-bold @(h.Score == history.Max(x => x.Score) ? "text-warning" : "")">@h.Score,0@(h.Score == history.Max(x => x.Score) ? " &#9733;" : "")</td>
                                                <td class="text-end">@(h.Passed ? Html.Raw("<span class='badge bg-success'>Aprovado</span>") : Html.Raw("<span class='badge bg-secondary'>Reprovado</span>"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    <hr class="border-warning opacity-50 mt-4 mb-2" />
                    <p class="mb-0">
                        <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Inscrito em: @item.RegistrationDate.ToString("dd/MM/yyyy HH:mm")</small>
                    </p>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="p-5 bg-dark-purple border border-warning rounded shadow-sm">
                <i class="bi bi-ticket-detailed text-warning" style="font-size: 3rem;"></i>
                <h4 class="text-light mt-3">Nenhuma Inscrição Encontrada</h4>
                <p class="text-muted lead">Você ainda não se inscreveu em nenhum evento.</p>
                <a asp-action="Index" class="btn btn-warning rounded-pill mt-2 fw-bold">Ver Eventos Disponíveis</a>
            </div>
        </div>
    }
</div>