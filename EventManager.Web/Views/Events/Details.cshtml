@model EventManager.Web.Models.Event

@{
    ViewData["Title"] = "Detalhes do Evento";
}

<div class="container mt-4">
    <div class="card bg-dark-purple border-warning shadow-sm">
        <div class="card-header border-warning pb-2 pt-3">
            <h2 class="text-warning fw-bold mb-0"><i class="bi bi-info-circle-fill me-2"></i>@Model.Title</h2>
        </div>
        <div class="card-body text-light">
            <h5 class="text-muted mb-4">@Model.Description</h5>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <p><i class="bi bi-calendar-event text-warning me-2"></i><strong>Data e Hora:</strong> @Model.DateTime.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><i class="bi bi-clock-history text-warning me-2"></i><strong>Carga Horária:</strong> @Model.WorkloadHours horas</p>
                </div>
                <div class="col-md-6 mb-3">
                    <p><i class="bi bi-person-badge text-warning me-2"></i><strong>Organizador:</strong> @(string.IsNullOrEmpty(Model.Organizer?.FullName) ? Model.Organizer?.UserName : Model.Organizer?.FullName)</p>
                    <p><i class="bi bi-people-fill text-warning me-2"></i><strong>Vagas Restantes:</strong> @(Model.TotalSlots - Model.Registrations.Count) de @Model.TotalSlots</p>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top border-warning opacity-75">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
                }

                @if (ViewBag.IsRegistered == true)
                {
                    <button class="btn btn-success fw-bold rounded-pill disabled"><i class="bi bi-check-circle-fill me-1"></i> Inscrição Confirmada</button>
                    <a asp-action="MyRegistrations" class="btn btn-outline-warning rounded-pill ms-2">Ver Minhas Inscrições</a>
                }
                else if (Model.Registrations.Count >= Model.TotalSlots)
                {
                    <button class="btn btn-secondary fw-bold rounded-pill disabled"><i class="bi bi-x-circle-fill me-1"></i> Vagas Esgotadas</button>
                }
                else
                {
                    <form asp-action="Register" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-warning fw-bold rounded-pill"><i class="bi bi-ticket-perforated-fill me-1"></i> Quero me Inscrever!</button>
                    </form>
                }

                <a asp-action="Index" class="btn btn-outline-light rounded-pill ms-2">Voltar para Eventos</a>
            </div>
        </div>
    </div>
</div>