@model EventManager.Web.Models.Event

@{
    ViewData["Title"] = "Gerenciar Participantes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning"><i class="bi bi-people-fill me-2"></i>Participantes: @Model.Title</h2>
        <a asp-action="MyEvents" class="btn btn-outline-light rounded-pill">Voltar para Meus Eventos</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card bg-dark-purple border-warning shadow-sm">
        <div class="card-body">
            @if (Model.Registrations.Any())
            {
                <!-- Cabecalho Desktop -->
                <div class="row fw-bold text-warning border-bottom border-warning pb-2 mb-3 d-none d-md-flex">
                    <div class="col-md-3">E-mail do Participante</div>
                    <div class="col-md-3">Inscrição</div>
                    <div class="col-md-2 text-center">Presença</div>
                    <div class="col-md-2 text-center">Nota (1-10)</div>
                    <div class="col-md-2 text-end">Ações</div>
                </div>

                @foreach (var reg in Model.Registrations)
                {
                    <form asp-action="UpdateParticipant" method="post" class="mb-3 border-bottom border-secondary pb-3">
                        <input type="hidden" name="eventId" value="@Model.Id" />
                        <input type="hidden" name="registrationId" value="@reg.Id" />
                        
                        <div class="row align-items-center">
                            <!-- E-mail -->
                            <div class="col-md-3 mb-2 mb-md-0 text-light text-break">
                                <i class="bi bi-person-circle text-warning me-2"></i>@(reg.Participant?.Email)
                            </div>
                            
                            <!-- Data -->
                            <div class="col-md-3 mb-2 mb-md-0 text-light small">
                                @reg.RegistrationDate.ToString("dd/MM/yyyy HH:mm")
                            </div>
                            
                            <!-- Presenca -->
                            <div class="col-md-2 mb-2 mb-md-0 d-flex justify-content-md-center align-items-center">
                                <span class="d-md-none text-warning me-2">Presença:</span>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" name="isPresenceConfirmed" value="true" @(reg.IsPresenceConfirmed ? "checked" : "") style="transform: scale(1.3); cursor: pointer;" />
                                    <input type="hidden" name="isPresenceConfirmed" value="false" />
                                </div>
                            </div>
                            
                            <!-- Nota -->
                            <div class="col-md-2 mb-2 mb-md-0 d-flex justify-content-md-center align-items-center">
                                <span class="d-md-none text-warning me-2">Nota:</span>
                                <input type="number" name="rating" class="form-control form-control-sm bg-dark text-light border-warning text-center fw-bold" min="1" max="10" value="@reg.Rating" style="width: 70px;" />
                            </div>
                            
                            <!-- Botao -->
                            <div class="col-md-2 text-md-end text-center mt-2 mt-md-0">
                                <button type="submit" class="btn btn-warning rounded-pill fw-bold w-100"><i class="bi bi-save-fill me-1"></i>Salvar</button>
                            </div>
                        </div>
                    </form>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people text-secondary" style="font-size: 3rem;"></i>
                    <p class="text-light mt-3 mb-0">Nenhum participante inscrito ainda.</p>
                </div>
            }
        </div>
    </div>
</div>