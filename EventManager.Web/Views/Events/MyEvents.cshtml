@model IEnumerable<EventManager.Web.Models.Event>

@{
    ViewData["Title"] = "Meus Eventos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-warning"><i class="bi bi-calendar-check-fill me-2"></i>Meus Eventos</h1>
    <a asp-action="Create" class="btn btn-warning fw-bold rounded-pill"><i class="bi bi-plus-circle-fill me-2"></i>Criar Novo Evento</a>
</div>

<div class="card bg-dark-purple border-warning shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="text-warning border-bottom border-warning">
                    <tr>
                        <th>Título</th>
                        <th>Data e Hora</th>
                        <th class="text-center">Vagas Preenchidas</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-light fw-bold">@item.Title</td>
                            <td class="text-light">@item.DateTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                <span class="badge bg-success fs-6 border border-light">
                                    @item.Registrations.Count inscrito(s)
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="ManageParticipants" asp-route-id="@item.Id" class="btn btn-sm btn-warning fw-bold rounded-pill me-1"><i class="bi bi-people-fill me-1"></i> Participantes</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light rounded-pill me-1"><i class="bi bi-pencil-fill"></i> Editar</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir este evento?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill"><i class="bi bi-trash-fill"></i> Excluir</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <i class="bi bi-calendar-x fs-1 d-block mb-3 text-secondary"></i>
                                Nenhum evento criado ainda.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>