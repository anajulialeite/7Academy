@model EventManager.Web.Models.Event

@{
    ViewData["Title"] = "Criar Novo Evento";
}

<div class="container mt-4">
    <h2 class="text-warning mb-4"><i class="bi bi-plus-circle-fill me-2"></i>Criar Novo Evento</h2>
    
    <div class="card bg-dark-purple border-warning shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="form-group mb-3">
                    <label asp-for="Title" class="form-label text-warning fw-bold"></label>
                    <input asp-for="Title" class="form-control bg-dark text-light border-warning" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label text-warning fw-bold"></label>
                    <textarea asp-for="Description" class="form-control bg-dark text-light border-warning" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="DateTime" class="form-label text-warning fw-bold"></label>
                        <input asp-for="DateTime" class="form-control bg-dark text-light border-warning" />
                        <span asp-validation-for="DateTime" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="WorkloadHours" class="form-label text-warning fw-bold"></label>
                        <input asp-for="WorkloadHours" class="form-control bg-dark text-light border-warning" />
                        <span asp-validation-for="WorkloadHours" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="TotalSlots" class="form-label text-warning fw-bold"></label>
                        <input asp-for="TotalSlots" class="form-control bg-dark text-light border-warning" />
                        <span asp-validation-for="TotalSlots" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">Cancelar</a>
                    <button type="submit" class="btn btn-warning rounded-pill fw-bold px-4">Criar Evento</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}