@model EventManager.Web.Models.Event

@{
    ViewData["Title"] = "Criar Evento";
}

<h1 class="text-primary mb-4">Criar Novo Evento</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold text-secondary"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold text-secondary"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="DateTime" class="form-label fw-bold text-secondary"></label>
                            <input asp-for="DateTime" class="form-control" type="datetime-local" />
                            <span asp-validation-for="DateTime" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="WorkloadHours" class="form-label fw-bold text-secondary"></label>
                            <input asp-for="WorkloadHours" class="form-control" type="number" min="1" />
                            <span asp-validation-for="WorkloadHours" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TotalSlots" class="form-label fw-bold text-secondary"></label>
                            <input asp-for="TotalSlots" class="form-control" type="number" min="1" />
                            <span asp-validation-for="TotalSlots" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <input type="submit" value="Criar Evento" class="btn btn-primary px-4" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
